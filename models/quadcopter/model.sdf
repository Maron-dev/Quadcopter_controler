<?xml version="1.0"?>
<sdf version="1.6">
  <model name="quadcopter">
    <pose>0 0 0.15 0 0 0</pose>
    <link name="base_link">
      <inertial><mass>1.5</mass><inertia><ixx>0.030</ixx><iyy>0.030</iyy><izz>0.055</izz></inertia></inertial>
      <collision name="body_collision"><geometry><box><size>0.28 0.18 0.10</size></box></geometry></collision>
      <visual name="body_visual"><geometry><box><size>0.28 0.18 0.10</size></box></geometry><material><ambient>0.06 0.08 0.11 1</ambient><diffuse>0.10 0.16 0.23 1</diffuse></material></visual>
      <visual name="arm_fl"><pose>0.16 0.16 0 0 0 0.7854</pose><geometry><box><size>0.45 0.025 0.025</size></box></geometry></visual>
      <visual name="arm_fr"><pose>0.16 -0.16 0 0 0 -0.7854</pose><geometry><box><size>0.45 0.025 0.025</size></box></geometry></visual>
      <visual name="rotor_fl"><pose>0.23 0.23 0.03 0 0 0</pose><geometry><cylinder><radius>0.14</radius><length>0.008</length></cylinder></geometry><material><ambient>0.1 0.6 0.9 0.35</ambient><diffuse>0.1 0.6 0.9 0.35</diffuse></material><transparency>0.55</transparency></visual>
      <visual name="rotor_fr"><pose>0.23 -0.23 0.03 0 0 0</pose><geometry><cylinder><radius>0.14</radius><length>0.008</length></cylinder></geometry><material><ambient>0.1 0.6 0.9 0.35</ambient><diffuse>0.1 0.6 0.9 0.35</diffuse></material><transparency>0.55</transparency></visual>
      <visual name="rotor_rl"><pose>-0.23 0.23 0.03 0 0 0</pose><geometry><cylinder><radius>0.14</radius><length>0.008</length></cylinder></geometry><material><ambient>0.1 0.6 0.9 0.35</ambient><diffuse>0.1 0.6 0.9 0.35</diffuse></material><transparency>0.55</transparency></visual>
      <visual name="rotor_rr"><pose>-0.23 -0.23 0.03 0 0 0</pose><geometry><cylinder><radius>0.14</radius><length>0.008</length></cylinder></geometry><material><ambient>0.1 0.6 0.9 0.35</ambient><diffuse>0.1 0.6 0.9 0.35</diffuse></material><transparency>0.55</transparency></visual>
    </link>
    <plugin name="gazebo_actuator" filename="libgazebo_actuator.so">
      <ros><namespace>/quadcopter</namespace></ros>
      <body_link>base_link</body_link>
      <thrust_coefficient>8.5e-6</thrust_coefficient>
      <torque_coefficient>1.6e-7</torque_coefficient>
      <arm_x>0.23</arm_x>
      <arm_y>0.23</arm_y>
      <motor_time_constant>0.06</motor_time_constant>
      <max_rotor_speed>1100.0</max_rotor_speed>
    </plugin>
  </model>
</sdf>
