Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Global Options:
    Fixed Frame: world
    Background Color: 35; 35; 35
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Plane: XY
      Cell Size: 1
      Plane Cell Count: 50
      Normal Cell Count: 0
      Reference Frame: <Fixed Frame>
    - Class: rviz_default_plugins/Path
      Name: Reference
      Enabled: true
      Topic: {Value: /quadcopter/path/reference}
      Line Style: Lines
      Line Width: 0.06
      Color: 15; 220; 255
    - Class: rviz_default_plugins/Path
      Name: Actual
      Enabled: true
      Topic: {Value: /quadcopter/path/actual}
      Line Style: Lines
      Line Width: 0.08
      Color: 255; 35; 25
  Tools:
    - Class: rviz_default_plugins/MoveCamera
  Enabled: true
Toolbars:
  toolButtonStyle: 2
Views:
  Current:
    Class: rviz_default_plugins/Orbit
    Distance: 30
    Near Clip Distance: 0.01
    Pitch: 0.75
    Yaw: 0.8
    Focal Point: {X: 5.5, Y: 0.0, Z: 1.0}
