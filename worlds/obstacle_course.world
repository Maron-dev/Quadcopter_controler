<?xml version="1.0"?>
<sdf version="1.6">
  <world name="obstacle_course">
    <include><uri>model://sun</uri></include>
    <include><uri>model://ground_plane</uri></include>
    <physics name="physics" type="ode">
      <max_step_size>0.002</max_step_size>
      <real_time_update_rate>500</real_time_update_rate>
    </physics>

    <!-- Niska ściana: trajektoria prowadzi nad nią. -->
    <model name="low_wall">
      <static>true</static><pose>2.0 0 0.6 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.35 3.2 1.2</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.35 3.2 1.2</size></box></geometry>
          <material><ambient>0.10 0.38 0.75 1</ambient><diffuse>0.12 0.48 0.95 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Trzy kolumny tworzące slalom. -->
    <model name="slalom_column_1">
      <static>true</static><pose>4.0 -0.45 1.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><cylinder><radius>0.38</radius><length>3.0</length></cylinder></geometry></collision>
        <visual name="visual"><geometry><cylinder><radius>0.38</radius><length>3.0</length></cylinder></geometry>
          <material><ambient>0.80 0.18 0.08 1</ambient><diffuse>0.95 0.25 0.10 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="slalom_column_2">
      <static>true</static><pose>5.4 0.45 1.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><cylinder><radius>0.38</radius><length>3.0</length></cylinder></geometry></collision>
        <visual name="visual"><geometry><cylinder><radius>0.38</radius><length>3.0</length></cylinder></geometry>
          <material><ambient>0.85 0.55 0.05 1</ambient><diffuse>1.00 0.68 0.08 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="slalom_column_3">
      <static>true</static><pose>6.8 -0.45 1.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><cylinder><radius>0.38</radius><length>3.0</length></cylinder></geometry></collision>
        <visual name="visual"><geometry><cylinder><radius>0.38</radius><length>3.0</length></cylinder></geometry>
          <material><ambient>0.50 0.10 0.72 1</ambient><diffuse>0.62 0.16 0.90 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Brama o prześwicie 2.4 m szerokości i 2.6 m wysokości. -->
    <model name="gate_left">
      <static>true</static><pose>9.0 1.45 1.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.45 0.50 3.0</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.45 0.50 3.0</size></box></geometry>
          <material><ambient>0.08 0.62 0.30 1</ambient><diffuse>0.10 0.78 0.38 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="gate_right">
      <static>true</static><pose>9.0 -1.45 1.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.45 0.50 3.0</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.45 0.50 3.0</size></box></geometry>
          <material><ambient>0.08 0.62 0.30 1</ambient><diffuse>0.10 0.78 0.38 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="gate_top">
      <static>true</static><pose>9.0 0 2.85 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.45 3.4 0.50</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.45 3.4 0.50</size></box></geometry>
          <material><ambient>0.08 0.62 0.30 1</ambient><diffuse>0.10 0.78 0.38 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="landing_pad">
      <static>true</static><pose>11.0 0 0.04 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><cylinder><radius>0.8</radius><length>0.08</length></cylinder></geometry></collision>
        <visual name="visual"><geometry><cylinder><radius>0.8</radius><length>0.08</length></cylinder></geometry>
          <material><ambient>0.12 0.12 0.12 1</ambient><diffuse>0.18 0.18 0.18 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Wizualizacja trajektorii referencyjnej z mission_obstacle_course.yaml.
         Elementy nie mają geometrii collision, więc nie oddziałują z dronem. -->
    <model name="reference_path">
      <static>true</static>
      <link name="segment_01">
        <pose>0 0 0.825 0 -1.57080 0</pose>
        <visual name="visual"><geometry><box><size>1.35 0.055 0.055</size></box></geometry>
          <material><ambient>0.05 0.85 1 1</ambient><diffuse>0.05 0.85 1 1</diffuse><emissive>0.02 0.45 0.60 1</emissive></material>
        </visual>
      </link>
      <link name="segment_02">
        <pose>0.6 0 1.85 0 -0.52807 0</pose>
        <visual name="visual"><geometry><box><size>1.38924 0.055 0.055</size></box></geometry>
          <material><ambient>0.05 0.85 1 1</ambient><diffuse>0.05 0.85 1 1</diffuse><emissive>0.02 0.45 0.60 1</emissive></material>
        </visual>
      </link>
      <link name="segment_03">
        <pose>1.9 0 2.2 0 0 0</pose>
        <visual name="visual"><geometry><box><size>1.4 0.055 0.055</size></box></geometry>
          <material><ambient>0.05 0.85 1 1</ambient><diffuse>0.05 0.85 1 1</diffuse><emissive>0.02 0.45 0.60 1</emissive></material>
        </visual>
      </link>
      <link name="segment_04">
        <pose>3.3 0.65 2.0 0 0.20639 0.74838</pose>
        <visual name="visual"><geometry><box><size>1.95192 0.055 0.055</size></box></geometry>
          <material><ambient>0.05 0.85 1 1</ambient><diffuse>0.05 0.85 1 1</diffuse><emissive>0.02 0.45 0.60 1</emissive></material>
        </visual>
      </link>
      <link name="segment_05">
        <pose>4.7 0 1.8 0 0 -1.07685</pose>
        <visual name="visual"><geometry><box><size>2.95296 0.055 0.055</size></box></geometry>
          <material><ambient>0.05 0.85 1 1</ambient><diffuse>0.05 0.85 1 1</diffuse><emissive>0.02 0.45 0.60 1</emissive></material>
        </visual>
      </link>
      <link name="segment_06">
        <pose>6.1 0 1.8 0 0 1.07685</pose>
        <visual name="visual"><geometry><box><size>2.95296 0.055 0.055</size></box></geometry>
          <material><ambient>0.05 0.85 1 1</ambient><diffuse>0.05 0.85 1 1</diffuse><emissive>0.02 0.45 0.60 1</emissive></material>
        </visual>
      </link>
      <link name="segment_07">
        <pose>7.5 0.65 1.8 0 0 -0.74838</pose>
        <visual name="visual"><geometry><box><size>1.91050 0.055 0.055</size></box></geometry>
          <material><ambient>0.05 0.85 1 1</ambient><diffuse>0.05 0.85 1 1</diffuse><emissive>0.02 0.45 0.60 1</emissive></material>
        </visual>
      </link>
      <link name="segment_08">
        <pose>9.0 0 1.8 0 0 0</pose>
        <visual name="visual"><geometry><box><size>1.6 0.055 0.055</size></box></geometry>
          <material><ambient>0.05 0.85 1 1</ambient><diffuse>0.05 0.85 1 1</diffuse><emissive>0.02 0.45 0.60 1</emissive></material>
        </visual>
      </link>
      <link name="segment_09">
        <pose>10.4 0 1.5 0 0.46365 0</pose>
        <visual name="visual"><geometry><box><size>1.34164 0.055 0.055</size></box></geometry>
          <material><ambient>0.05 0.85 1 1</ambient><diffuse>0.05 0.85 1 1</diffuse><emissive>0.02 0.45 0.60 1</emissive></material>
        </visual>
      </link>
      <link name="segment_10">
        <pose>11.0 0 0.675 0 1.57080 0</pose>
        <visual name="visual"><geometry><box><size>1.05 0.055 0.055</size></box></geometry>
          <material><ambient>0.05 0.85 1 1</ambient><diffuse>0.05 0.85 1 1</diffuse><emissive>0.02 0.45 0.60 1</emissive></material>
        </visual>
      </link>
    </model>
  </world>
